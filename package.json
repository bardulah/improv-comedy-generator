{
  "name": "improv-comedy-generator",
  "version": "2.0.0",
  "description": "AI-powered improv comedy generator: creates scenes, prompts, and punchlines for playful performances.",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "improv": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc && npm run copy-data",
    "copy-data": "mkdir -p dist/data && cp -r src/data/* dist/data/",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "lint": "eslint src tests --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "prepack": "npm run build && npm test",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "improv",
    "comedy",
    "generator",
    "cli",
    "entertainment",
    "theater",
    "creative-writing"
  ],
  "author": "Improv Comedy Generator Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bardulah/improv-comedy-generator.git"
  },
  "bugs": {
    "url": "https://github.com/bardulah/improv-comedy-generator/issues"
  },
  "homepage": "https://github.com/bardulah/improv-comedy-generator#readme",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^30.2.0",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.5",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "chalk": "^5.3.0"
  }
}
